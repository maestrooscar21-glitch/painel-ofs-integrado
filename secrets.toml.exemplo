# Copie para "secrets.toml" (ou cole no campo Secrets do Streamlit Cloud). NUNCA suba o secrets.toml de verdade.

senha_app = "senha-para-entrar-no-painel"        # compartilhada com quem usa o painel
senha_admin = "senha-so-do-administrador"         # libera Configurações e exclusões (só você)

[banco]
host = "aws-1-us-west-2.pooler.supabase.com"
port = 5432
user = "postgres.SEUPROJETO"
password = "SENHA-DO-BANCO"
database = "postgres"

# Modo seguro: lê OFS do Supabase, bloqueia alterações ainda não validadas.
[integracao_ofs]
habilitada = true
